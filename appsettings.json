{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "User": "your-smtp-user",
    "Password": "your-smtp-password",
    "From": "no-reply@example.com",
    "PickupDirectory": "" // optional: if set, emails will be written to this directory instead of sent
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_SECRET_KEY",
    "Issuer": "Web_BanHang",
    "Audience": "Web_BanHangClients",
    "ExpireMinutes": 60
  }
}
